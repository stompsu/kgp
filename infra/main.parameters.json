{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=polandcentral}"
    },
    "apiImage": {
      "value": "${SERVICE_API_IMAGE_NAME=}"
    },
    "authTenantId": {
      "value": "${KGP_AUTH_TENANT_ID=}"
    },
    "authTenantSubdomain": {
      "value": "${KGP_AUTH_TENANT_SUBDOMAIN=}"
    },
    "apiClientId": {
      "value": "${KGP_API_CLIENT_ID=}"
    }
  }
}
